{
  "realm": "gizmoshop",
  "enabled": true,
  "displayName": "BFF Kickstart",
  "loginTheme": "gizmoshop",
  "accountTheme": "gizmoshop",
  "emailTheme": "gizmoshop",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "registrationFlow": "BFF registration",
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "ssoSessionIdleTimeout": 300,
  "smtpServer": {
    "host": "mailhog",
    "port": "1025",
