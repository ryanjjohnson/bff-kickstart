  "roles": {
    "realm": [
      {
        "name": "Internal User",
        "description": "See MeResponse#external in the backend - carried in the realm_access.roles claim, independent of the bff-kickstart-client authorization roles below"
      }
    ],
    "client": {
      "bff-kickstart-client": [
        {
          "name": "Admin",
          "description": "Full CRUD on all bff-kickstart resources"
        },
        {
          "name": "Inspector",
          "description": "Manage inspections, read facilities and permits"
        },
        {
          "name": "Viewer",
          "description": "Read-only access to all resources"
        },
        {
          "name": "Data Manager",
          "description": "Bulk CSV export/import on all resources"
        },
        {
          "name": "API Developer",
          "description": "Access to Swagger UI / API docs. Does not by itself grant access to any endpoint - the other roles above determine that."
        },
        {
          "name": "API Owner",
          "description": "Composite super-role: any operation on any API endpoint, plus Swagger access. Expands at token-issuance time to Admin+Inspector+Viewer+Data Manager+API Developer - no @PreAuthorize changes needed for it to work.",
          "composite": true,
          "composites": {
            "client": {
              "bff-kickstart-client": [
                "Admin",
                "Inspector",
                "Viewer",
                "Data Manager",
                "API Developer"
              ]
            }
          }
        }
      ]
    }
  },
