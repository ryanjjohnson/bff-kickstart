  "clients": [
    {
      "clientId": "bff-kickstart-client",
      "name": "BFF Kickstart Backend",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "bff-kickstart-secret",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/bff-kickstart/login/oauth2/code/keycloak",
        "http://localhost:3000/bff-kickstart/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/bff-kickstart/##http://localhost:3000/bff-kickstart/##http://localhost:8081/bff-kickstart/",
        "backchannel.logout.url": "http://host.docker.internal:8081/bff-kickstart-api/logout/connect/back-channel/keycloak",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "client-roles-resource-access",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "usermodel.clientRoleMapping.clientId": "bff-kickstart-client"
          }
        },
        {
          "name": "audience-self",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "bff-kickstart-client",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "address-line-1",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "claim.name": "addressLine1",
            "jsonType.label": "String",
            "user.attribute": "addressLine1"
          }
        },
        {
          "name": "address-line-2",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "claim.name": "addressLine2",
            "jsonType.label": "String",
            "user.attribute": "addressLine2"
          }
        },
        {
          "name": "city",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "claim.name": "city",
            "jsonType.label": "String",
            "user.attribute": "city"
          }
        },
        {
          "name": "state",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "claim.name": "state",
            "jsonType.label": "String",
            "user.attribute": "state"
          }
        },
        {
          "name": "zip",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "claim.name": "zip",
            "jsonType.label": "String",
            "user.attribute": "zip"
          }
        },
        {
          "name": "telephone",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "claim.name": "telephone",
            "jsonType.label": "String",
            "user.attribute": "telephone"
          }
        }
      ]
    },
    {
      "clientId": "bff-kickstart-service-client",
      "name": "BFF Kickstart Demo API Client",
      "description": "Demo client_credentials client for machine-to-machine API callers - see README's 'API clients (resource server)' section. Requires the backend's API_EXPOSED=true.",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "bff-kickstart-service-secret",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "client-roles-resource-access",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "resource_access.bff-kickstart-client.roles",
            "jsonType.label": "String",
            "usermodel.clientRoleMapping.clientId": "bff-kickstart-client"
          }
        }
      ]
    }
