    "fromDisplayName": "BFF Kickstart",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "authenticationFlows": [
    {
      "alias": "BFF registration",
      "description": "BFF registration flow - no user-chosen username",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "registration-page-form",
          "authenticatorFlow": true,
          "flowAlias": "BFF registration form",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "BFF registration form",
      "description": "BFF registration form - system username generation + password",
      "providerId": "form-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "bff-registration-user-creation",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false
        },
        {
          "authenticator": "registration-password-action",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"Username\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"Email\", \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}}, {\"name\": \"firstName\", \"displayName\": \"First Name\", \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"middleName\", \"displayName\": \"Middle Name\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"annotations\": {\"inputHelperTextBefore\": \"Optional. Its initial is used when generating your username.\"}}, {\"name\": \"lastName\", \"displayName\": \"Last Name\", \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"addressLine1\", \"displayName\": \"Address Line 1\", \"group\": \"address\", \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"addressLine2\", \"displayName\": \"Address Line 2\", \"group\": \"address\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"city\", \"displayName\": \"City\", \"group\": \"address\", \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"state\", \"displayName\": \"State\", \"group\": \"address\", \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"length\": {\"min\": 2, \"max\": 2}}, \"annotations\": {\"inputTypeMaxlength\": 2, \"inputHelperTextBefore\": \"Two-letter abbreviation, e.g. OH\"}}, {\"name\": \"zip\", \"displayName\": \"Zip Code\", \"group\": \"address\", \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"pattern\": {\"pattern\": \"^[0-9]{5}(-[0-9]{4})?$\", \"error-message\": \"Please enter a valid zip code.\"}}}, {\"name\": \"telephone\", \"displayName\": \"Phone Number\", \"group\": \"address\", \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"pattern\": {\"pattern\": \"^[0-9()+\\\\-\\\\s]{7,20}$\", \"error-message\": \"Please enter a valid phone number.\"}}}, {\"name\": \"securityQuestion\", \"displayName\": \"Security Question\", \"group\": \"security\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"annotations\": {\"inputType\": \"select\"}, \"validations\": {\"options\": {\"options\": [\"In what city did you meet your spouse/significant other?\", \"In what city or town did your mother and father meet?\", \"In what town was your first job?\", \"What is the first name of the boy or girl that you first kissed?\", \"What is the middle name of your youngest child?\", \"What is the name of your favorite childhood friend?\", \"What is your maternal grandmother's maiden name?\", \"What is your oldest sibling's birthday month and year? (e.g., January 1900)\", \"What is your oldest sibling's middle name?\", \"What school did you attend for sixth grade?\", \"What street did you live on in third grade?\", \"What was the last name of your third grade teacher?\", \"What was the make of your first car?\", \"What was the name of your first stuffed animal?\", \"What was your childhood nickname?\", \"What was your first phone number including area code? (e.g., 000-000-0000)\"]}}}, {\"name\": \"securityAnswer\", \"displayName\": \"Security Answer\", \"group\": \"security\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"annotations\": {\"inputHelperTextBefore\": \"In the event you forget your password, we'll use this to verify your identity.\"}}, {\"name\": \"gizmo_username\", \"displayName\": \"Generated Username\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"annotations\": {\"inputHelperTextBefore\": \"System-generated (lastname_fm_#). Mirrors the account username; kept as a stable attribute in case the username is ever remapped.\"}}], \"groups\": [{\"name\": \"address\", \"displayHeader\": \"Mailing Address\"}, {\"name\": \"security\", \"displayHeader\": \"Password Recovery\", \"displayDescription\": \"Used to verify your identity if you forget your password.\"}], \"unmanagedAttributePolicy\": \"ADMIN_EDIT\"}"
          ]
        }
      }
    ],
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "gizmoshop-ad",
        "providerId": "ldap",
        "config": {
          "enabled": [
            "false"
          ],
          "priority": [
            "1"
          ],
          "editMode": [
            "READ_ONLY"
          ],
          "vendor": [
            "ad"
          ],
          "usernameLDAPAttribute": [
            "sAMAccountName"
          ],
          "rdnLDAPAttribute": [
            "cn"
          ],
          "uuidLDAPAttribute": [
            "objectGUID"
          ],
          "userObjectClasses": [
            "person, organizationalPerson, user"
          ],
          "connectionUrl": [
            "ldaps://CHANGE-ME-ad.gizmoshop.local:636"
          ],
          "usersDn": [
            "OU=Users,DC=gizmoshop,DC=local"
          ],
          "authType": [
            "simple"
          ],
          "bindDn": [
            "CHANGE-ME\\svc-keycloak"
          ],
          "bindCredential": [
            "CHANGE-ME"
          ],
          "searchScope": [
            "2"
          ],
          "pagination": [
            "true"
          ],
          "importEnabled": [
            "true"
          ],
          "syncRegistrations": [
            "false"
          ],
          "trustEmail": [
            "true"
          ],
          "useKerberosForPasswordAuthentication": [
            "false"
          ],
          "batchSizeForSync": [
            "1000"
          ],
          "fullSyncPeriod": [
            "-1"
          ],
          "changedSyncPeriod": [
            "-1"
          ],
          "cachePolicy": [
            "DEFAULT"
          ],
          "useTruststoreSpi": [
            "ldapsOnly"
          ],
          "connectionPooling": [
            "true"
          ],
          "startTls": [
            "false"
          ]
        }
      }
    ]
