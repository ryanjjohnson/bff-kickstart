server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Don't advertise the nginx version in Server: / error pages. Only visible to
    # anything that reaches the origin directly (the Cloudflare tunnel is
    # outbound-only, so that's LAN-only today) - cheap hygiene regardless.
    server_tokens off;

    # nginx's default is 1MB, which 413s any real upload before it reaches the
    # backend - a phone photo on an inspection ("Take photo") or a CSV bulk
    # import. Keep this at/above the backend's multipart max-request-size
    # (spring.servlet.multipart.* in application.properties, currently 25MB) so
    # the backend - not nginx - is the single authority on the size limit and
    # can return a clean JSON 413 rather than nginx's bare HTML one.
    client_max_body_size 25m;

    location = /health {
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location = / {
        # $http_host (not $host, which drops the port): nginx's `return` with a
        # bare path auto-absolutizes using $scheme://$host, silently dropping
        # a non-default port - the same gotcha as the Host header below.
        return 302 $scheme://$http_host${FRONTEND_BASE_PATH}/;
    }

    # The backend has no browser-facing path of its own - server.servlet.context-path
    # (${BACKEND_BASE_PATH}) is purely internal now, never reachable directly.
    # Everything the backend serves is nested under the frontend's own path
    # instead, via these four locations, each rewriting the matched external
    # prefix onto the backend's real internal one (proxy_pass with a trailing
    # path replaces the location's matched prefix - that's what does the
    # rewriting here, same mechanism as ordinary nginx prefix-proxying).
    # /logout needs an exact match (no sub-path is ever called through this
    # proxy - the back-channel logout endpoint is called directly, server-to-
    # server, by Keycloak, never by the browser); the other three are always
    # called with something after them.
    #
    # $http_host (not $host, which drops the port) preserves the original
    # "host:port" the browser used, matching the Vite dev proxy, so Spring
    # computes the same scheme+host half of its OAuth2 {baseUrl}.
    # X-Forwarded-Prefix supplies the path half - Spring's ForwardedHeaderFilter
    # (server.forward-headers-strategy=framework) uses it to override what it
    # thinks its own context-path is for URL generation, regardless of
    # server.servlet.context-path's actual (internal-only) value. Verified
    # directly against the backend:
    #   curl -H "X-Forwarded-Prefix: /bff-kickstart" \
    #     http://localhost:8081${BACKEND_BASE_PATH}/oauth2/authorization/keycloak
    #   -> redirect_uri=.../bff-kickstart/login/oauth2/code/keycloak
    #
    # X-Forwarded-Proto is deliberately NOT set: Spring's ForwardedHeaderFilter
    # resets the port to the scheme's default (80/443) when Proto is forwarded
    # without a matching X-Forwarded-Port, which breaks this same redirect-uri
    # computation - and there's no TLS termination happening here for it to
    # convey anyway.
    location ${FRONTEND_BASE_PATH}/api/ {
        proxy_pass http://backend:${BACKEND_PORT}${BACKEND_BASE_PATH}/api/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Prefix ${FRONTEND_BASE_PATH};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cookie_path / /;
    }

    # Swagger/OpenAPI (springdoc) - only present at all when SWAGGER_ENABLED=true
    # on the backend, and gated further behind the API Developer role once you're
    # there (see SecurityConfig). Proxied the same way as /api/ above so the
    # backend never needs a browser-facing port of its own for this either.
    location ${FRONTEND_BASE_PATH}/v3/api-docs {
        proxy_pass http://backend:${BACKEND_PORT}${BACKEND_BASE_PATH}/v3/api-docs;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Prefix ${FRONTEND_BASE_PATH};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cookie_path / /;
    }

    location ${FRONTEND_BASE_PATH}/swagger-ui/ {
        proxy_pass http://backend:${BACKEND_PORT}${BACKEND_BASE_PATH}/swagger-ui/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Prefix ${FRONTEND_BASE_PATH};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cookie_path / /;
    }

    # springdoc's own default entry point - it 302s to swagger-ui/index.html.
    location = ${FRONTEND_BASE_PATH}/swagger-ui.html {
        proxy_pass http://backend:${BACKEND_PORT}${BACKEND_BASE_PATH}/swagger-ui.html;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Prefix ${FRONTEND_BASE_PATH};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cookie_path / /;
    }

    location ${FRONTEND_BASE_PATH}/oauth2/ {
        proxy_pass http://backend:${BACKEND_PORT}${BACKEND_BASE_PATH}/oauth2/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Prefix ${FRONTEND_BASE_PATH};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cookie_path / /;
    }

    location ${FRONTEND_BASE_PATH}/login/ {
        proxy_pass http://backend:${BACKEND_PORT}${BACKEND_BASE_PATH}/login/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Prefix ${FRONTEND_BASE_PATH};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cookie_path / /;
    }

    location = ${FRONTEND_BASE_PATH}/logout {
        proxy_pass http://backend:${BACKEND_PORT}${BACKEND_BASE_PATH}/logout;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Prefix ${FRONTEND_BASE_PATH};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cookie_path / /;
    }

    # Content-addressed build assets (index-<hash>.js/.css, fonts, images) never
    # change under a given name - safe to cache hard, forever. This is what makes
    # a deploy cheap: only the tiny un-hashed control files below must refetch.
    location ${FRONTEND_BASE_PATH}/assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The PWA control files carry no content hash, so they MUST always be
    # revalidated - otherwise a new build is invisible until a stale copy
    # expires. no-cache also makes Cloudflare bypass edge-caching them (it does
    # not cache no-cache/no-store/private), so the service worker actually sees
    # each new build instead of a CDN copy that can lag hours behind a deploy.
    location = ${FRONTEND_BASE_PATH}/sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location = ${FRONTEND_BASE_PATH}/registerSW.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location = ${FRONTEND_BASE_PATH}/manifest.webmanifest {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # The SPA shell. Its index.html is the un-hashed entry point that names the
    # current hashed bundle, so it must never be cached either. This is also the
    # right place for the document security headers (they matter for the HTML
    # document, not for JS/CSS subresources):
    #   CSP    - backstop against XSS; 'unsafe-inline' on styles only because
    #            HeroUI/React emit inline style attributes (scripts stay 'self',
    #            the build has no inline <script>). Everything is same-origin -
    #            no CDN, self-hosted fonts - so the rest is 'self'.
    #   HSTS   - HTTPS terminates at Cloudflare; this pins the browser to https.
    #            Deliberately NO 'preload': that directive invites submitting the
    #            whole morningside.site apex to the browser preload list, which
    #            would force HTTPS on every sibling subdomain - including the
    #            HTTP-only LAN services on this domain (OPNsense, Frigate, ...).
    #   frame  - X-Frame-Options + frame-ancestors 'none' = no clickjacking.
    # The build output (base '${FRONTEND_BASE_PATH}/' in vite.config.ts) is copied
    # into this subdirectory in the Dockerfile, so root + try_files mirrors the
    # physical layout one-to-one.
    location ${FRONTEND_BASE_PATH}/ {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'";
        add_header X-Frame-Options "DENY";
        add_header X-Content-Type-Options "nosniff";
        add_header Referrer-Policy "no-referrer";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains";
        try_files $uri $uri/ ${FRONTEND_BASE_PATH}/index.html;
    }
}
