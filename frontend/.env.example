# Base paths this app is mounted under - see README.md "Backend proxying".
# Change these two values (and rebuild) to reuse this app under different paths;
# keep them in sync with the root .env's FRONTEND_BASE_PATH / BACKEND_BASE_PATH
# used by docker-compose, nginx, and the backend's server.servlet.context-path.
VITE_FRONTEND_BASE_PATH=/bff-kickstart
# Deliberately NOT VITE_-prefixed: the backend's own path is nested under
# FRONTEND_BASE_PATH (browser-facing) by vite.config.ts's proxy rewrite and
# nginx.conf.template's location blocks, so the browser never needs this
# value - a VITE_ prefix would auto-inject it into the client bundle for no
# reason. Only vite.config.ts itself reads it (via loadEnv, which - unlike
# import.meta.env in app code - can read any variable, not just VITE_-prefixed
# ones), to know the backend's actual internal path to rewrite requests onto.
BACKEND_BASE_PATH=/bff-kickstart-api

# --- Session timing (all in seconds; see src/lib/config.ts for the fallbacks) ---
# Idle time before the client signs the user out.
VITE_IDLE_TIMEOUT_SECONDS=300
# How long before that deadline the countdown warning dialog appears (must be
# less than VITE_IDLE_TIMEOUT_SECONDS; with the defaults, the warning shows
# after 4 minutes idle and counts down the final minute).
VITE_IDLE_WARNING_SECONDS=60
# How often the SPA re-confirms its auth state with the backend (each check
# also makes the backend re-verify the session against Keycloak via token
# introspection - see MeController).
VITE_AUTH_RECHECK_SECONDS=30
