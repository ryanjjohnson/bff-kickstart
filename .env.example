# Copy this file to .env and adjust as needed. docker-compose.yml reads these.

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
# Must match keycloak/realm-export/gizmoshop-realm.json client secret
KEYCLOAK_CLIENT_SECRET=bff-kickstart-secret

# --- Email (SMTP) ---
# Both the backend app and Keycloak send through Mailhog (a fake SMTP server - nothing is
# actually delivered; view what was "sent" at http://localhost:8025).
SMTP_HOST=mailhog
SMTP_PORT=1025

# --- Backend ---
BACKEND_PORT=8081
# The backend's own internal path (server.servlet.context-path) - purely an
# implementation detail now, never reachable directly or seen by a browser
# (see frontend/README.md's "Backend proxying"). Must match frontend/.env's
# BACKEND_BASE_PATH (deliberately not VITE_-prefixed, so it's never injected
# into the client bundle - only vite.config.ts's proxy rewrite target reads
# it) and is baked into nginx.conf.template's proxy locations. Changing this
# requires rebuilding the frontend image (docker compose up --build).
BACKEND_BASE_PATH=/bff-kickstart-api
# Enables the OAuth2 Resource Server (Bearer JWT / client_credentials API clients) on /api/**
# - see README's "API clients (resource server)". Off by default; existing frontend-only
# deployments see no behavior change.
API_EXPOSED=false
# Enables springdoc's OpenAPI docs + Swagger UI, reachable through the frontend's own proxy
# (nginx.conf.template's /swagger-ui/ and /v3/api-docs locations) - see README's "API docs
# (Swagger)". Off by default, and gated further behind the API Developer role once enabled.
SWAGGER_ENABLED=false
# Server-side session inactivity timeout (Spring's server.servlet.session.timeout - any
# Spring duration works: "15m", "900s", "1h"). Keep this comfortably LONGER than the
# frontend's idle logout below: the client's own logout must always find a live session
# to log out of, or the RP-initiated Keycloak redirect breaks (see the comment above
# server.servlet.session.timeout in application.properties).
SESSION_TIMEOUT=15m

# --- Frontend ---
# Host port nginx (the built frontend's container) publishes on.
FRONTEND_PORT=3000
# Host port the Vite dev server listens on (only relevant when running
# `npm run dev` outside Docker) - included here only so it can be added to
# the backend's CORS allow-list below.
FRONTEND_DEV_PORT=5173
# Path the frontend SPA is mounted under (Vite's `base`) - must match
# frontend/.env's VITE_FRONTEND_BASE_PATH. Same rebuild caveat as
# BACKEND_BASE_PATH above.
FRONTEND_BASE_PATH=/bff-kickstart

# --- Session timing (frontend, all in seconds) ---
# Baked into the client bundle at build time (compose passes them to the image as
# VITE_-prefixed build args), so changing any of these requires a frontend rebuild
# (docker compose up --build frontend). For `npm run dev` outside Docker, the same
# knobs live in frontend/.env as VITE_IDLE_TIMEOUT_SECONDS etc.
#
# Idle time before the SPA signs the user out (default: 5 minutes).
IDLE_TIMEOUT_SECONDS=300
# How long before that deadline the countdown warning dialog appears (must be less
# than IDLE_TIMEOUT_SECONDS; with the defaults, the warning shows at 4 minutes idle
# and counts down the final minute).
IDLE_WARNING_SECONDS=60
# How often the SPA re-confirms its auth state with the backend; each check also
# triggers the backend's Keycloak token introspection (see MeController), so this
# bounds how long a Keycloak-revoked session can outlive its revocation client-side.
AUTH_RECHECK_SECONDS=30
